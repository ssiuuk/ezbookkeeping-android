            android:action="com.ssiuuk.ezbookkeeping.CHANGE_SERVER"
            android:targetPackage="com.ssiuuk.ezbookkeeping"
            android:targetClass="com.ssiuuk.ezbookkeeping.LaunchActivity" />
    </shortcut>
</shortcuts>
