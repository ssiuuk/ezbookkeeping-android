<?xml version="1.0" encoding="utf-8"?>
<!-- plain http is allowed so a server on the home network (e.g. http://192.168.1.10:8080) works -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
